{
  "name": "新世界 · SHINSEKAI",
  "short_name": "SHINSEKAI",
  "description": "Anime cinematic cockpit startpage — live wallpapers, bookmarks, focus timer. Works fully offline.",
  "lang": "ja",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
